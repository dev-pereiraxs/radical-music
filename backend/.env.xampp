# Copie este arquivo para ".env" e ajuste os valores.

# --- Banco de dados MySQL (XAMPP: usuário root, senha vazia) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=radical_music
# Use true em bancos na nuvem (Aiven). No XAMPP deixe vazio.
DB_SSL=

# --- Segurança ---
# Troque por um texto longo e aleatório antes de publicar.
SECRET_KEY=troque-esta-chave-por-algo-longo-e-aleatorio

# --- Endereço do site (front-end) ---
FRONTEND_URL=http://localhost:5173

# --- Conta de administrador criada pelo init_db.py ---
ADMIN_EMAIL=admin@radicalmusic.com
ADMIN_PASSWORD=admin123

# --- Pagamento (Mercado Pago, ambiente de teste) ---
# Deixe vazio para usar o pagamento SIMULADO (funciona sem conta nenhuma).
# Para o ambiente de teste real, cole aqui o Access Token de teste.
MP_ACCESS_TOKEN=
# Opcional: URL pública para o Mercado Pago avisar quando o pagamento for aprovado.
MP_NOTIFICATION_URL=
